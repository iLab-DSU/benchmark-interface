NEXT_PUBLIC_APP_TITLE=Weval
NEXT_PUBLIC_APP_TAGLINE=Massive Evaluation Platform
NEXT_PUBLIC_BLUEPRINT_CONFIG_REPO_SLUG=user/repo # your blueprints repo

STORAGE_PROVIDER=your_storage_provider
APP_S3_BUCKET_NAME=your_s3_bucket_name_for_results
APP_S3_REGION=your_s3_region
APP_AWS_ACCESS_KEY_ID=your_aws_access_key_id
APP_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

NEXT_PUBLIC_ADMIN_SECRET_SLUG=secret_admin_slug
GITHUB_TOKEN=github_token
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
SESSION_SECRET=your_session_secret_for_oauth
HOMEPAGE_DEV_CACHE_DURATION_MS=30000
ANALYSIS_DEV_CACHE_DURATION_MS=600000

# API Keys (openai needed for embeddings, others can be e.g. openrouter, x, google, etc.)
OPENAI_API_KEY=your_openai_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
X_API_KEY=your_xai_api_key
ANYSCALE_API_KEY=your_anyscale_api_key
TOGETHERAI_API_KEY=your_together_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key

# Sentry Error Tracking (optional but recommended for production)
# IMPORTANT: These should be set in Railway environment variables, NOT in your local .env
# This keeps local development faster and prevents noise from dev errors
# See docs/SENTRY.md for details
SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here  # Same as SENTRY_DSN, for client-side
SENTRY_ORG=your_sentry_org_slug  # Optional: for source map uploads
SENTRY_PROJECT=your_sentry_project_slug  # Optional: for source map uploads
SENTRY_AUTH_TOKEN=your_sentry_auth_token  # Optional: for source map uploads in CI/CD
SENTRY_RELEASE=git-commit-sha-or-version  # Optional: set automatically in CI/CD

# Background Function Authentication
# Required for calling internal background API routes (factcheck, evaluations, etc.)
# Generate with: openssl rand -hex 32
BACKGROUND_FUNCTION_AUTH_TOKEN=your_generated_token_here

# App URL (used for OAuth redirects and background function calls)
# Local: http://localhost:3172
# Production: https://your-app.up.railway.app (or custom domain)
URL=http://localhost:3172
NEXT_PUBLIC_APP_URL=http://localhost:3172

# Custom Theme Colors
NEXT_PUBLIC_THEME_COLOR_PRIMARY_HSL="229 39% 52%"
NEXT_PUBLIC_THEME_COLOR_FOREGROUND_HSL="330 3% 19%"
NEXT_PUBLIC_THEME_COLOR_BACKGROUND_HSL="42 63% 94%"
NEXT_PUBLIC_THEME_COLOR_SURFACE_HSL="0 0% 100%"
NEXT_PUBLIC_THEME_COLOR_DESTRUCTIVE_HSL="8 86% 60%"
NEXT_PUBLIC_THEME_COLOR_ACCENT_HSL="51 26% 57%"
NEXT_PUBLIC_THEME_COLOR_WARNING_HSL="46 90% 65%"
NEXT_PUBLIC_THEME_COLOR_FOREGROUND_ON_PRIMARY_HSL="0 0% 100%"

# See readme for more env details

# --- Google sign-in (added by the auth/admin work) ---
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be exactly:
#   http://localhost:3172/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. Admins are the bootstrap root of trust: they can always sign
# in and cannot be removed or demoted from the admin UI.
AUTH_ADMIN_EMAILS=
# Comma-separated non-admin addresses. Optional; admins can also add people at
# runtime from Admin -> Users.
AUTH_ALLOWED_EMAILS=

# --- Temporary password sign-in (bypasses Google) ---
# Leave disabled unless you genuinely need to sign in without OAuth.
AUTH_DEV_LOGIN=false
AUTH_DEV_PASSWORD=

# --- Email notifications (SMTP) ---
# Optional. With SMTP_HOST unset the app still records notifications in the
# in-app inbox; it simply does not email them. Nothing breaks.
#
# Port and encryption go together: 465 is implicit TLS (SMTP_SECURE=true), 587
# and 25 start plaintext and upgrade via STARTTLS (SMTP_SECURE=false). Leave
# SMTP_SECURE blank to derive it from the port.
#
# Gmail / Google Workspace: host smtp.gmail.com, port 587, and an App Password
# (requires 2FA) — a normal account password is rejected.
# Many hosts block outbound port 25, so prefer 587 or 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Must be an address on a domain you control; relays reject unknown senders.
NOTIFY_FROM_EMAIL=
